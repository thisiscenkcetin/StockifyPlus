@{
    ViewBag.Title = "Stok Girişi";
    var products = ViewBag.Products as List<StockifyPlus.Models.Product> ?? new List<StockifyPlus.Models.Product>();
}

<div class="sp-page-shell">
<div class="sp-page-header">
    <h2 class="sp-page-title">
        <i class="fas fa-arrow-up"></i> Stok Girişi
    </h2>
</div>

<div class="sp-form-grid">
    <div class="sp-form-card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-arrow-up"></i> Stok Girişi Kaydı
                </h5>
            </div>
            <div class="card-body">
                <form method="post" asp-action="StockIn">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="productId" class="form-label mb-0">Ürün Seçin <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="scanBarcodeBtn" data-bs-toggle="modal" data-bs-target="#barcodeScannerModal">
                                <i class="fas fa-camera"></i> Kameradan Oku
                            </button>
                        </div>
                        <select class="form-select" id="productId" name="productId" required>
                            <option value="">-- Ürün Seçin --</option>
                            @foreach (var product in products)
                            {
                                <option value="@product.Id">
                                    @product.Name (Stok: @product.StockQuantity)
                                </option>
                            }
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="quantity" class="form-label">Giriş Miktarı <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="quantity" name="quantity" 
                               min="1" required placeholder="Örn: 100">
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label">Açıklama (İsteğe Bağlı)</label>
                        <textarea class="form-control" id="description" name="description" rows="3" 
                                  placeholder="Satın alma siparişi numarası, tarihçeci vb..."></textarea>
                    </div>
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            }
                        </div>
                    }
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-custom">
                            <i class="fas fa-save"></i> Kaydet
                        </button>
                        <a href="@Url.Action("Index", "StockMovement")" class="btn btn-secondary btn-custom">
                            <i class="fas fa-times"></i> İptal
                        </a>
                    </div>
                </form>
            </div>
    </div>
    <div class="sp-help-card">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="fas fa-info-circle"></i> Bilgi
                </h6>
                <p class="small">Stok girişi, yeni ürün alımı sırasında stok miktarını artırmak için kullanılır.</p>
                <hr>
                <p class="small"><strong>Örnek:</strong> Tedarikçiden 100 adet ürün gelmişse, bu formu kullanarak 100 adet giriş yaparsınız.</p>
            </div>
    </div>
</div>
</div>

@section Scripts {
    @await Html.PartialAsync("_BarcodeScanner")
}
