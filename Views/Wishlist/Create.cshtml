@model StockifyPlus.Models.Wishlist
@{
    ViewBag.Title = "Yeni İstek Ekle";
}

<div class="sp-page-shell">
    <div class="sp-form-card sp-narrow-card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-plus-circle"></i> @ViewBag.Title
            </h5>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <form method="post" asp-action="Create" asp-controller="Wishlist">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label">
                        <i class="fas fa-box"></i> Ürün Adı *
                    </label>
                    <input asp-for="ProductName" class="form-control" placeholder="Ürün adını giriniz..." />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        <i class="fas fa-align-left"></i> Açıklama
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ürün hakkında notlar..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TargetPrice" class="form-label">
                            <i class="fas fa-bullseye"></i> Hedef Fiyat
                        </label>
                        <input asp-for="TargetPrice" type="number" step="0.01" class="form-control" placeholder="0,00" aria-describedby="targetPriceHelp" />
                        <small id="targetPriceHelp" class="form-text">Bu fiyata ulaşınca bildirim alırsınız.</small>
                        <span asp-validation-for="TargetPrice" class="text-danger d-block"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CurrentPrice" class="form-label">
                            <i class="fas fa-tag"></i> Mevcut Fiyat
                        </label>
                        <input asp-for="CurrentPrice" type="number" step="0.01" class="form-control" placeholder="0,00" />
                        <span asp-validation-for="CurrentPrice" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority" class="form-label">
                            <i class="fas fa-flag"></i> Öncelik
                        </label>
                        <select asp-for="Priority" class="form-select">
                            <option value="1">Düşük</option>
                            <option value="2" selected>Orta</option>
                            <option value="3">Yüksek</option>
                            <option value="4">Acil</option>
                        </select>
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label">
                            <i class="fas fa-tags"></i> Kategori
                        </label>
                        <input asp-for="Category" class="form-control" placeholder="Örn: Elektronik, Kitap..." />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductUrl" class="form-label">
                        <i class="fas fa-link"></i> Ürün Linki
                    </label>
                    <input asp-for="ProductUrl" type="url" class="form-control" placeholder="https://..." aria-describedby="productUrlHelp" />
                    <small id="productUrlHelp" class="form-text">E-ticaret sitesindeki ürün sayfası linki.</small>
                    <span asp-validation-for="ProductUrl" class="text-danger d-block"></span>
                </div>

                <div class="sp-actions-row mt-4">
                    <button type="submit" class="btn btn-primary btn-custom">
                        <i class="fas fa-save"></i> Kaydet
                    </button>
                    <a href="@Url.Action("Index", "Wishlist")" class="btn btn-secondary btn-custom">
                        <i class="fas fa-times"></i> İptal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
