

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const decimalInputs = document.querySelectorAll('input[type="number"][step="0.01"]');
        
        decimalInputs.forEach(function(input) {
            input.addEventListener('input', function() {
                validateDecimalInput(this);
            });
            
            input.addEventListener('blur', function() {
                validateDecimalInput(this);
            });
        });
        
        function validateDecimalInput(input) {
            const value = input.value.trim();
            const validationSpan = input.parentElement.querySelector('.text-danger');
            
            if (value === '') {
                input.classList.remove('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = '';
                }
                return;
            }
            
            const decimalPattern = /^\d+([.,]\d{0,2})?$/;
            const numericValue = parseFloat(value.replace(',', '.'));
            
            if (!decimalPattern.test(value) || isNaN(numericValue)) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'Geçerli bir fiyat giriniz (örn: 99.99)';
                }
            } else if (numericValue < 0) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'Fiyat 0\'dan büyük olmalıdır';
                }
            } else if (numericValue > 999999.99) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'Fiyat 999999.99\'dan küçük olmalıdır';
                }
            } else {
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = '';
                }
            }
        }
        
        const productNameInput = document.querySelector('input[name="ProductName"]');
        if (productNameInput) {
            productNameInput.addEventListener('input', function() {
                validateProductName(this);
            });
            
            productNameInput.addEventListener('blur', function() {
                validateProductName(this);
            });
        }
        
        function validateProductName(input) {
            const value = input.value.trim();
            const validationSpan = input.parentElement.querySelector('.text-danger');
            
            if (value === '') {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'Ürün adı boş bırakılamaz.';
                }
            } else if (value.length < 2) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'Ürün adı en az 2 karakter olmalıdır.';
                }
            } else if (value.length > 200) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'Ürün adı en fazla 200 karakter olmalıdır.';
                }
            } else {
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = '';
                }
            }
        }
        
        const productUrlInput = document.querySelector('input[name="ProductUrl"]');
        if (productUrlInput) {
            productUrlInput.addEventListener('input', function() {
                validateProductUrl(this);
            });
            
            productUrlInput.addEventListener('blur', function() {
                validateProductUrl(this);
            });
        }
        
        function validateProductUrl(input) {
            const value = input.value.trim();
            const validationSpan = input.parentElement.querySelector('.text-danger');
            
            if (value === '') {
                input.classList.remove('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = '';
                }
                return;
            }
            
            const urlPattern = /^https?:\/\/.+/i;
            
            if (!urlPattern.test(value)) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'Geçerli bir URL giriniz (http:// veya https:// ile başlamalı)';
                }
            } else if (value.length > 500) {
                input.classList.add('is-invalid');
                input.classList.remove('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = 'URL en fazla 500 karakter olmalıdır.';
                }
            } else {
                input.classList.remove('is-invalid');
                input.classList.add('is-valid');
                if (validationSpan) {
                    validationSpan.textContent = '';
                }
            }
        }
        
        const forms = document.querySelectorAll('form[method="post"]');
        forms.forEach(function(form) {
            form.addEventListener('submit', function(e) {
                let isValid = true;
                
                if (productNameInput) {
                    validateProductName(productNameInput);
                    if (productNameInput.classList.contains('is-invalid')) {
                        isValid = false;
                    }
                }
                
                decimalInputs.forEach(function(input) {
                    validateDecimalInput(input);
                    if (input.classList.contains('is-invalid')) {
                        isValid = false;
                    }
                });
                
                if (productUrlInput) {
                    validateProductUrl(productUrlInput);
                    if (productUrlInput.classList.contains('is-invalid')) {
                        isValid = false;
                    }
                }
                
                if (!isValid) {
                    e.preventDefault();
                    
                    const validationSummary = document.querySelector('[asp-validation-summary]');
                    if (validationSummary) {
                        validationSummary.style.display = 'block';
                        validationSummary.innerHTML = '<i class="fas fa-exclamation-circle"></i> Lütfen form hatalarını düzeltin.';
                    }
                    
                    const firstInvalid = form.querySelector('.is-invalid');
                    if (firstInvalid) {
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        firstInvalid.focus();
                    }
                }
            });
        });
    });
</script>

<style>
    
    .form-control.is-invalid,
    .form-select.is-invalid {
        border-color: #dc3545;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
    
    .form-control.is-valid,
    .form-select.is-valid {
        border-color: #198754;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
    
    .text-danger {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #dc3545;
    }
    
    
    .form-control,
    .form-select {
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    
    .form-control:focus.is-invalid,
    .form-select:focus.is-invalid {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
    }
    
    .form-control:focus.is-valid,
    .form-select:focus.is-valid {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }
</style>
